{
  "version": 2,
  "builds": [
    {
      "src": "front/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "back/src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "back/src/main.ts"
    },
    {
      "src": "/(.*)",
      "dest": "front/$1"
    }
  ]
}